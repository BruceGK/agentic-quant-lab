# Template only. Supply real values privately; the application does not load this file.
# Never commit a completed copy.
DATABASE_URL=
SEC_USER_AGENT=
LEDGER_PATH=/absolute/durable/path/sec.jsonl
# Azure deployment uses managed identity; local development keeps the defaults above.
# LEDGER_BACKEND=azure
# AZURE_SUBSCRIPTION_ID=
# AZURE_CLIENT_ID=
# AZURE_STORAGE_ACCOUNT_URL=https://ACCOUNT.blob.core.windows.net
# AZURE_STORAGE_CONTAINER=aql-audit-ledger
# AZURE_LEDGER_PREFIX=sec
# DATABASE_AUTH=azure
# Azure DATABASE_URL must use verify-full TLS and must not contain a password.
UNIVERSE_CIKS=
# Optional separate raw-ingestion CIK scope; omit to use UNIVERSE_CIKS.
# INGEST_CIKS=
CATCHUP_START=
# Omission is explicitly reported as heartbeat=disabled by local CLI commands.
HEARTBEAT_URL=
# Optional code identity; the package source-tree hash is always recorded.
RECORDER_GIT_SHA=
